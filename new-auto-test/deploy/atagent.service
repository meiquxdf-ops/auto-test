[Unit]
Description=Auto Test Agent (atagent)
Documentation=file:///etc/atagent/config.yaml
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=@DATA_DIR@
# ATEST_CONFIG 是二进制唯一认的配置环境变量；显式 --config 优先，两者指同一份文件
Environment=ATEST_CONFIG=@CONFIG@
ExecStart=@BIN@ run --config @CONFIG@

Restart=always
RestartSec=3s

# 任务进程都跑在本 unit 的 cgroup 里，停止/重启时必须整组回收，
# 否则被测脚本 fork 出来的子进程会留成孤儿。
KillMode=control-group
KillSignal=SIGTERM
TimeoutStopSec=30s
SendSIGKILL=yes

LimitNOFILE=65535
LimitNPROC=65535
OOMScoreAdjust=-500

StandardOutput=journal
StandardError=journal
SyslogIdentifier=atagent

[Install]
WantedBy=multi-user.target
